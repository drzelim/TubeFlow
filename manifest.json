{
    "manifest_version": 3,
    "name": "TubeFlow",
    "version": "0.1.0",
    "author": "DrZelim",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://www.youtube.com/"
    ],
    "action": {
        "default_title": "TubeFlow",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        },
        "default_popup": "popup.html"
    },
    "content_scripts": [{
        "matches": ["https://www.youtube.com/*"],
        "js": ["scripts/settings.js", "scripts/speed.js", "scripts/hide-shorts.js"],
        "run_at": "document_start",
        "all_frames": true
    }]
}
